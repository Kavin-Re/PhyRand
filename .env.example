# Copy to .env (which is git-ignored) and fill in. Never commit a real .env.

# REQUIRED. Master API token: full control of the key authority.
# Generate with:  phyrand token      (or: python -c "import secrets; print(secrets.token_urlsafe(32))")
# The server refuses to start if this is missing, shorter than 32 characters
# or looks like a placeholder.
VAULT_MASTER_TOKEN=

# Serial device of the Nucleo board's ST-LINK virtual COM port.
# Linux: /dev/ttyACM0   macOS: /dev/tty.usbmodemXXXX   Windows: COM5
QRNG_SERIAL_PORT=/dev/ttyACM0

# true  (default): fail closed. /request-keys returns 503 unless the board is
#                  connected and passing its health tests.
# false: fall back to OS-only keys, labelled "os-only" in the response.
PHYRAND_REQUIRE_HARDWARE=true

# Assumed min-entropy (bits per byte) of the board's output. Sizes the health
# test cutoffs. An engineering assumption, not a validated figure.
PHYRAND_ASSUMED_MIN_ENTROPY=4.0

# Hardware bytes mixed into each 256-bit key.
PHYRAND_RAW_BYTES_PER_KEY=128

# Where the escrowed keys are stored (directory is created with mode 0700).
PHYRAND_VAULT_DIR=vault

# Bind address. Keep loopback unless an HTTPS reverse proxy sits in front.
PHYRAND_HOST=127.0.0.1
PHYRAND_PORT=8000

# Comma-separated list of extra origins allowed to call the API from a
# browser. Empty (default) = same-origin only. "*" is rejected.
PHYRAND_CORS_ORIGINS=

# --- client side (phyrand encrypt/decrypt --url, scripts/auto_unlock.py) ---
# PHYRAND_API_URL=https://vault.example.org
# PHYRAND_RELEASE_TOKEN=
